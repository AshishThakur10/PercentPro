# Release signing template.
#
# Copy this file to keystore.properties at the project root and fill in real
# values. keystore.properties is gitignored and must never be committed.
#
# storeFile is resolved relative to the project root, not the app/ module. An
# absolute path also works but breaks on any other machine.
storeFile=../your-release-key.jks
storePassword=your-store-password
keyAlias=your-key-alias
keyPassword=your-key-password
