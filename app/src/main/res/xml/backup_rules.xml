<?xml version="1.0" encoding="utf-8"?>
<!--
   Pre-Android-12 backup rules. Everything is excluded for the same reason given
   in data_extraction_rules.xml: the app makes no network requests and stores
   everything locally, which is only true if nothing is uploaded.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>